<div class="section color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="collection-header">
      {% if section.settings.show_image and collection.image %}
        <div class="collection-header__image" data-animate>
          <img
            src="{{ collection.image | image_url: width: 1600 }}"
            alt="{{ collection.image.alt | default: collection.title | escape }}"
            width="{{ collection.image.width }}"
            height="{{ collection.image.height }}"
          >
        </div>
      {% endif %}
      <div class="section-heading section-heading--center" data-animate>
        <p class="eyebrow">Nos rayons</p>
        <h1>{{ collection.title }}</h1>
        {% if collection.description != blank %}
          <div class="collection-header__description rte">{{ collection.description }}</div>
        {% endif %}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'collection_message' and block.settings.collection == collection.handle -%}
          <div class="collection-message" data-animate {{ block.shopify_attributes }}>
            {% if block.settings.text != blank %}<div class="collection-message__text">{{ block.settings.text }}</div>{% endif %}
            {% if block.settings.button_label != blank or block.settings.button_label_2 != blank %}
              <div class="collection-message__actions">
                {% if block.settings.button_label != blank %}
                  <a href="{{ block.settings.button_url | default: '/pages/contact' }}" class="btn">{{ block.settings.button_label }}</a>
                {% endif %}
                {% if block.settings.button_label_2 != blank %}
                  <a href="{{ block.settings.button_url_2 | default: routes.collections_url }}" class="btn btn--outline">{{ block.settings.button_label_2 }}</a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {% paginate collection.products by section.settings.products_per_page %}
      <div class="collection-toolbar">
        <p class="collection-toolbar__count">
          {{ 'collections.general.items_count' | t: count: collection.products_count }}
        </p>
        <div class="collection-toolbar__controls">
          <form data-sort-form>
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}<input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">{%- endfor -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != nil -%}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '.' }}">{%- endif -%}
                {%- if filter.max_value.value != nil -%}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '.' }}">{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            <select name="sort_by" class="field__select" aria-label="{{ 'collections.general.sort_button' | t }}" onchange="this.form.submit()">
              {% for option in collection.sort_options %}
                <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
              {% endfor %}
            </select>
          </form>
        </div>
      </div>

      <div class="collection-layout{% if section.settings.enable_filters %} collection-layout--with-filters{% endif %}">
        {% if section.settings.enable_filters %}
          <aside class="filters-panel">
            <form data-filters-form>
              {% if collection.sort_by != blank %}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{% endif %}
              {%- assign active_filters = 0 -%}
              {% for filter in collection.filters %}
                {%- assign active_filters = active_filters | plus: filter.active_values.size -%}
                {% if filter.type == 'price_range' %}
                  {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}{%- assign active_filters = active_filters | plus: 1 -%}{%- endif -%}
                  <details class="filters-panel__group" open>
                    <summary>{{ filter.label }}</summary>
                    <div class="filters-panel__price">
                      <label>
                        <span class="visually-hidden">Prix minimum</span>
                        <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '.' }}" placeholder="0" min="0" step="1">
                      </label>
                      <span>—</span>
                      <label>
                        <span class="visually-hidden">Prix maximum</span>
                        <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '.' }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '.' }}" min="0" step="1">
                      </label>
                      <span>{{ cart.currency.symbol }}</span>
                    </div>
                  </details>
                {% elsif filter.values.size > 0 %}
                  <details class="filters-panel__group" open>
                    <summary>{{ filter.label }}</summary>
                    <div class="filters-panel__options">
                      {% for value in filter.values %}
                        <label>
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                            onchange="this.form.submit()"
                          >
                          {{ value.label }} ({{ value.count }})
                        </label>
                      {% endfor %}
                    </div>
                  </details>
                {% endif %}
              {% endfor %}
              <div class="filters-panel__actions">
                <button type="submit" class="btn btn--outline btn--small">{{ 'collections.general.filter_and_sort' | t }}</button>
                {% if active_filters > 0 %}
                  <a href="{{ collection.url }}{% if collection.sort_by != blank %}?sort_by={{ collection.sort_by }}{% endif %}" class="filters-panel__clear">{{ 'collections.general.clear_all' | t }}</a>
                {% endif %}
              </div>
            </form>
          </aside>
        {% endif %}

        <div>
          {% if collection.products.size == 0 %}
            <p style="opacity:0.7; padding: 40px 0;">{{ 'collections.general.no_products' | t }}</p>
          {% else %}
            <div class="grid grid--collection">
              {% for product in collection.products %}
                {% render 'product-card', product: product %}
              {% endfor %}
            </div>
          {% endif %}

          {% render 'pagination', paginate: paginate %}
        </div>
      </div>
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Ambiance de couleur",
      "options": [
        { "value": "ivoire", "label": "Ivoire" },
        { "value": "blanc-casse", "label": "Blanc cassé" }
      ],
      "default": "ivoire"
    },
    { "type": "checkbox", "id": "show_image", "label": "Afficher l'image de collection", "default": true },
    { "type": "checkbox", "id": "enable_filters", "label": "Activer les filtres", "default": true },
    { "type": "range", "id": "products_per_page", "label": "Produits par page", "min": 8, "max": 48, "step": 4, "default": 24 }
  ],
  "blocks": [
    {
      "type": "collection_message",
      "name": "Message de collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection concernée", "info": "Le message n'apparaît que sur la page de cette collection" },
        { "type": "richtext", "id": "text", "label": "Texte" },
        { "type": "text", "id": "button_label", "label": "Bouton principal" },
        { "type": "url", "id": "button_url", "label": "Lien du bouton principal", "info": "Si vide : page Contact" },
        { "type": "text", "id": "button_label_2", "label": "Bouton secondaire" },
        { "type": "url", "id": "button_url_2", "label": "Lien du bouton secondaire", "info": "Si vide : toutes les collections" }
      ]
    }
  ]
}
{% endschema %}
