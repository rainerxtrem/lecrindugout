{% if section.settings.enable %}
<section class="seasonal color-scheme-{{ section.settings.color_scheme }}{% unless section.settings.image %} has-stripes{% endunless %}{% if section.settings.image %} seasonal--image{% endif %}">
  {% if section.settings.image %}
    <div class="seasonal__media">
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="{{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    </div>
  {% endif %}
  <div class="page-width seasonal__content" data-animate>
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    {% if section.settings.title != blank %}<h2>{{ section.settings.title }}</h2>{% endif %}
    {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="btn{% if section.settings.image %} btn--light{% endif %}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Mise en avant saisonnière",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Activer cette section", "default": true },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Ambiance de couleur (sans image)",
      "options": [
        { "value": "chocolat", "label": "Chocolat" },
        { "value": "sauge-profond", "label": "Vert profond" },
        { "value": "sombre", "label": "Noir doux" },
        { "value": "terracotta", "label": "Terracotta" }
      ],
      "default": "sauge-profond"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Mention courte", "default": "En ce moment" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Les coffrets de fin d'année" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Une sélection pensée pour les fêtes, entre gourmandise et élégance." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir la sélection" },
    { "type": "url", "id": "button_url", "label": "Lien du bouton" }
  ],
  "presets": [
    { "name": "Mise en avant saisonnière" }
  ]
}
{% endschema %}
