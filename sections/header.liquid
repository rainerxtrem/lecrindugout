{%- liquid
  assign main_menu = linklists[section.settings.menu]
-%}

<header class="site-header color-scheme-{{ section.settings.color_scheme }}" data-site-header>
  <div class="page-width site-header__inner">
    <a href="{{ routes.root_url }}" class="site-header__logo">
      {% if settings.logo %}
        <img
          src="{{ settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name }}"
          width="{{ settings.logo.width }}"
          height="{{ settings.logo.height }}"
          style="--logo-width: {{ settings.logo_width }}px; max-width: var(--logo-width);"
        >
      {% else %}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>

    {% if main_menu %}
      <nav class="site-nav" aria-label="{{ 'header.catalog' | t }}">
        <ul class="site-nav__list" role="list" style="display:flex; align-items:center; gap:inherit; list-style:none;">
          {% for link in main_menu.links %}
            <li class="site-nav__item" data-nav-item>
              {% if link.links.size > 0 %}
                <button class="site-nav__link" data-nav-trigger aria-expanded="false" aria-haspopup="true">
                  {{ link.title }}
                  {% render 'icon', name: 'chevron-down' %}
                </button>
                {% render 'mega-menu', link: link, section: section %}
              {% else %}
                <a href="{{ link.url }}" class="site-nav__link">{{ link.title }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    <div class="site-header__actions">
      {% if section.settings.show_search %}
        <button class="btn--icon" data-search-open aria-label="{{ 'general.search.search' | t }}">
          {% render 'icon', name: 'search' %}
        </button>
      {% endif %}

      <a href="{{ routes.account_url }}" class="btn--icon" aria-label="{{ 'general.account.title' | t }}">
        {% render 'icon', name: 'account' %}
      </a>

      {% if settings.cart_type == 'drawer' %}
        <button class="btn--icon" data-cart-drawer-open aria-label="{{ 'cart.general.title' | t }}" style="position:relative;">
          {% render 'icon', name: 'cart' %}
          <span data-cart-count style="position:absolute; top:-2px; right:-2px; background:var(--color-terracotta); color:#fff; font-size:0.65rem; border-radius:50%; width:18px; height:18px; display:flex; align-items:center; justify-content:center;{% if cart.item_count == 0 %}display:none;{% endif %}">{{ cart.item_count }}</span>
        </button>
      {% else %}
        <a href="{{ routes.cart_url }}" class="btn--icon" aria-label="{{ 'cart.general.title' | t }}" style="position:relative;">
          {% render 'icon', name: 'cart' %}
          <span data-cart-count style="position:absolute; top:-2px; right:-2px; background:var(--color-terracotta); color:#fff; font-size:0.65rem; border-radius:50%; width:18px; height:18px; display:flex; align-items:center; justify-content:center;{% if cart.item_count == 0 %}display:none;{% endif %}">{{ cart.item_count }}</span>
        </a>
      {% endif %}

      <button class="btn--icon" data-mobile-nav-open aria-label="{{ 'general.menu.open' | t }}" style="display:none;" id="MobileNavOpenBtn">
        {% render 'icon', name: 'menu' %}
      </button>
    </div>
  </div>

  {% if section.settings.show_search %}
    <div class="header-search-panel" data-search-panel hidden style="border-top:1px solid var(--scheme-border); background:var(--scheme-bg);">
      <form action="{{ routes.search_url }}" method="get" class="page-width" style="display:flex; gap:10px; padding-block:16px;">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}" autofocus>
        <input type="hidden" name="type" value="product">
        <button type="submit" class="btn btn--small">{{ 'general.search.search' | t }}</button>
      </form>
    </div>
  {% endif %}
</header>

{% comment %} Navigation mobile {% endcomment %}
<div class="mobile-nav-drawer" data-mobile-nav hidden>
  <div class="mobile-nav-drawer__overlay" data-mobile-nav-close></div>
  <div class="mobile-nav-drawer__panel">
    <div class="mobile-nav-drawer__header">
      <button class="btn--icon" data-mobile-nav-close aria-label="{{ 'general.menu.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>
    {% if main_menu %}
      <nav class="mobile-nav" aria-label="{{ 'header.catalog' | t }}">
        {% for link in main_menu.links %}
          {% if link.links.size > 0 %}
            <details>
              <summary>{{ link.title }} {% render 'icon', name: 'chevron-down' %}</summary>
              <div class="mobile-nav__sublist">
                {% for child in link.links %}
                  {% if child.links.size > 0 %}
                    <p style="font-weight:600; margin: 8px 0 2px;">{{ child.title }}</p>
                    {% for grandchild in child.links %}
                      <a href="{{ grandchild.url }}" class="mobile-nav__link">{{ grandchild.title }}</a>
                    {% endfor %}
                  {% else %}
                    <a href="{{ child.url }}" class="mobile-nav__link">{{ child.title }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            </details>
          {% else %}
            <a href="{{ link.url }}" class="mobile-nav__link" style="display:block; padding:16px 4px; font-family:var(--font-heading); font-size:1.05rem; border-bottom:1px solid rgba(0,0,0,0.08);">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}

    <div style="margin-top:auto; padding-top:24px;">
      {% render 'social-icons' %}
    </div>
  </div>
</div>

<style>
  @media screen and (max-width: 989px) {
    #MobileNavOpenBtn { display: inline-flex !important; }
  }
</style>

{% schema %}
{
  "name": "En-tête",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu principal",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Afficher la recherche",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Ambiance de couleur",
      "options": [
        { "value": "ivoire", "label": "Ivoire" },
        { "value": "blanc-casse", "label": "Blanc cassé" },
        { "value": "sable", "label": "Sable" }
      ],
      "default": "ivoire"
    }
  ],
  "blocks": [
    {
      "type": "menu_feature",
      "name": "Image dans le mega-menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_item_title",
          "label": "Nom exact de l'item de menu ciblé",
          "info": "Doit correspondre exactement au libellé du lien de premier niveau (ex. Catalogue)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Légende"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Lien"
        }
      ]
    }
  ]
}
{% endschema %}
