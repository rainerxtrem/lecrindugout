<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <link rel="canonical" href="{{ canonical_url }}">

  {% if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}

  {%- unless page_title == blank -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
  {%- endunless -%}

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title }}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">

  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  {{ content_for_header }}

  <style>
    {%- comment -%} Polices natives Shopify {%- endcomment -%}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}

    :root{
      --font-heading: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      --font-heading-weight: {{ settings.type_header_font.weight }};
      --font-heading-style: {{ settings.type_header_font.style }};
      --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      --font-body-weight: {{ settings.type_body_font.weight }};
      --font-body-style: {{ settings.type_body_font.style }};
      --heading-scale: {{ settings.heading_scale | default: 100 }};
      --body-scale: {{ settings.body_scale | default: 100 }};

      --color-ivory: {{ settings.color_ivory }};
      --color-off-white: {{ settings.color_off_white }};
      --color-sand: {{ settings.color_sand }};
      --color-sage: {{ settings.color_sage }};
      --color-sage-dark: {{ settings.color_sage_dark }};
      --color-terracotta: {{ settings.color_terracotta }};
      --color-bordeaux: {{ settings.color_bordeaux }};
      --color-gold: {{ settings.color_gold }};
      --color-brown: {{ settings.color_brown }};
      --color-chocolate: {{ settings.color_chocolate }};
      --color-ink: {{ settings.color_ink }};
      --color-text-on-light: {{ settings.color_text_on_light }};
      --color-text-on-dark: {{ settings.color_text_on_dark }};

      --radius-button: {{ settings.border_radius }}px;
      --radius-card: {{ settings.card_radius }}px;
      --page-width: {{ settings.page_width }}px;
      --spacing-section: {{ settings.spacing_sections }}px;
    }
  </style>

  <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'layout.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'components.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'sections.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'animations.css' | asset_url }}">

  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  {% if settings.cart_type == 'drawer' %}
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
  {% endif %}

  {%- if request.page_type == 'product' -%}
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</head>

<body class="template-{{ request.page_type }}">
  <a class="visually-hidden skip-to-content-link" href="#MainContent">
    {{ 'accessibility.skip_to_content' | t }}
  </a>

  {% sections 'header-group' %}

  <main id="MainContent" class="main-content" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% if settings.cart_type == 'drawer' %}
    {% section 'cart-drawer' %}
  {% endif %}
</body>
</html>
