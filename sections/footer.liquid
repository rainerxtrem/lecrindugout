<footer class="site-footer has-stripes color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        {% if settings.logo %}
          <img
            src="{{ settings.logo | image_url: width: 240 }}"
            alt="{{ shop.name }}"
            width="{{ settings.logo.width }}"
            height="{{ settings.logo.height }}"
            style="max-width:160px; filter: brightness(0) invert(1); opacity:0.92;"
          >
        {% else %}
          <span class="site-header__logo-text">{{ shop.name }}</span>
        {% endif %}
        {% if section.settings.tagline != blank %}
          <p class="site-footer__tagline">{{ section.settings.tagline }}</p>
        {% endif %}
        {% render 'social-icons' %}
      </div>

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'link_list' %}
            {% assign footer_menu = linklists[block.settings.menu] %}
            {% if footer_menu.links.size > 0 %}
              <div {{ block.shopify_attributes }}>
                <p class="site-footer__heading">{{ block.settings.title }}</p>
                <ul class="site-footer__list" role="list">
                  {% for link in footer_menu.links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          {% when 'contact' %}
            <div {{ block.shopify_attributes }}>
              <p class="site-footer__heading">{{ block.settings.title }}</p>
              <div class="site-footer__list site-footer__contact">
                {% if block.settings.show_address and shop.address.city != blank %}
                  <p>{{ shop.address.address1 }}{% if shop.address.address2 != blank %}, {{ shop.address.address2 }}{% endif %}<br>{{ shop.address.zip }} {{ shop.address.city }}</p>
                {% endif %}
                {% if shop.phone != blank %}<p><a href="tel:{{ shop.phone | remove: ' ' }}">{{ shop.phone }}</a></p>{% endif %}
                {% if block.settings.text != blank %}{{ block.settings.text }}{% endif %}
              </div>
            </div>
          {% when 'hours' %}
            {%- capture hours_rows -%}
              {%- assign days = 'lundi,mardi,mercredi,jeudi,vendredi,samedi,dimanche' | split: ',' -%}
              {%- for day in days -%}
                {%- assign hours = block.settings[day] -%}
                {%- if hours != blank -%}
                  <div class="site-footer__hours-row"><dt>{{ day | capitalize }}</dt><dd>{{ hours }}</dd></div>
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {% if hours_rows != blank %}
              <div {{ block.shopify_attributes }}>
                <p class="site-footer__heading">{{ block.settings.title }}</p>
                <dl class="site-footer__hours">{{ hours_rows }}</dl>
                {% if block.settings.note != blank %}<p class="site-footer__hours-note">{{ block.settings.note }}</p>{% endif %}
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.legal_text }}</p>
      <div class="site-footer__payments">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Ambiance de couleur",
      "options": [
        { "value": "chocolat", "label": "Chocolat" },
        { "value": "brun", "label": "Brun" },
        { "value": "sombre", "label": "Noir doux" }
      ],
      "default": "chocolat"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Phrase d'accroche",
      "default": "Une sélection de produits d'exception pour les amoureux des belles choses."
    },
    {
      "type": "text",
      "id": "legal_text",
      "label": "Mention légale courte",
      "default": "Tous droits réservés."
    }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Coordonnées",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Nous trouver" },
        { "type": "checkbox", "id": "show_address", "label": "Afficher l'adresse de la boutique", "info": "Reprise des réglages Shopify", "default": true },
        { "type": "richtext", "id": "text", "label": "Texte (horaires…)" }
      ]
    },
    {
      "type": "hours",
      "name": "Horaires d'ouverture",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Horaires" },
        { "type": "paragraph", "content": "Ex. : 9h30 – 19h, ou Fermé. Un jour laissé vide n'est pas affiché." },
        { "type": "text", "id": "lundi", "label": "Lundi" },
        { "type": "text", "id": "mardi", "label": "Mardi" },
        { "type": "text", "id": "mercredi", "label": "Mercredi" },
        { "type": "text", "id": "jeudi", "label": "Jeudi" },
        { "type": "text", "id": "vendredi", "label": "Vendredi" },
        { "type": "text", "id": "samedi", "label": "Samedi" },
        { "type": "text", "id": "dimanche", "label": "Dimanche" },
        { "type": "text", "id": "note", "label": "Précision (facultatif)", "info": "Ex. : Ouvert les dimanches de décembre" }
      ]
    },
    {
      "type": "link_list",
      "name": "Colonne de liens",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre de la colonne",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}
