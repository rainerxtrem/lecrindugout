{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Carte cadeau — {{ shop.name }}</title>
  {{ content_for_header }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  <style>
    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: {{ settings.color_chocolate }}; color: {{ settings.color_text_on_dark }}; font-family: Georgia, serif; text-align: center; padding: 24px; box-sizing: border-box; }
    .gift-card { max-width: 420px; width: 100%; }
    .gift-card__shop { text-transform: uppercase; letter-spacing: 0.16em; font-size: 1.4rem; margin: 0 0 32px; }
    .gift-card__amount { font-size: 2.6rem; margin: 0 0 8px; }
    .gift-card__code { display: inline-block; margin: 24px 0; padding: 14px 22px; border: 1px solid currentColor; letter-spacing: 0.12em; font-family: monospace; font-size: 1.1rem; }
    .gift-card__qr { display: flex; justify-content: center; margin: 12px 0 24px; }
    .gift-card__qr img, .gift-card__qr canvas { background: #fff; padding: 10px; }
    .gift-card a { color: inherit; }
  </style>
</head>
<body>
  <div class="gift-card">
    <p class="gift-card__shop">{{ shop.name }}</p>
    <p class="gift-card__amount">{{ gift_card.balance | money }}</p>
    {% if gift_card.balance != gift_card.initial_value %}
      <p>Valeur initiale : {{ gift_card.initial_value | money }}</p>
    {% endif %}
    {% if gift_card.expired or gift_card.enabled == false %}
      <p>Cette carte cadeau n'est plus valable.</p>
    {% else %}
      {% if gift_card.expires_on %}<p>Valable jusqu'au {{ gift_card.expires_on | date: '%d/%m/%Y' }}</p>{% endif %}
      <div class="gift-card__code">{{ gift_card.code | format_code }}</div>
      <div class="gift-card__qr" id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <p><a href="{{ shop.url }}">Utiliser ma carte sur la boutique</a></p>
    {% endif %}
  </div>
  <script>
    window.addEventListener('load', function () {
      var el = document.getElementById('QrCode');
      if (el && window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 140, height: 140 });
    });
  </script>
</body>
</html>
