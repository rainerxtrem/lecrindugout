{% if section.settings.image %}
  <section class="editorial-split color-scheme-{{ section.settings.color_scheme }}">
    <div class="editorial-split__media">
      <img
        src="{{ section.settings.image | image_url: width: 1400 }}"
        srcset="{{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 1400 }} 1400w"
        sizes="(min-width: 900px) 50vw, 100vw"
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    </div>
    <div class="editorial-split__content">
      <div class="editorial-split__inner" data-animate>
        {% render 'postal-shipping-content', section: section %}
      </div>
    </div>
  </section>
{% else %}
  <div class="section color-scheme-{{ section.settings.color_scheme }}">
    <div class="page-width">
      <div class="text-band" data-animate>
        <span class="text-band__icon">{% render 'icon', name: 'truck' %}</span>
        {% render 'postal-shipping-content', section: section %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Envoi postal",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Ambiance de couleur",
      "options": [
        { "value": "ivoire", "label": "Ivoire" },
        { "value": "blanc-casse", "label": "Blanc cassé" },
        { "value": "sable", "label": "Sable" },
        { "value": "lin", "label": "Lin (taupe clair)" }
      ],
      "default": "blanc-casse"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Mention courte", "default": "Expédition" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Une sélection pensée pour être envoyée" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Certains de nos produits et coffrets sont spécialement adaptés à l'expédition par voie postale. Nous pouvons vous accompagner dans la sélection des produits les plus adaptés."
    },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir les produits expédiables" },
    { "type": "url", "id": "button_url", "label": "Lien du bouton" }
  ],
  "presets": [
    { "name": "Envoi postal" }
  ]
}
{% endschema %}
