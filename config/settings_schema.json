[
  {
    "name": "theme_info",
    "theme_name": "L'Écrin du Goût",
    "theme_version": "1.0.0",
    "theme_author": "Atelier Numérique",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Logo & identité",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Largeur du logo",
        "min": 80,
        "max": 260,
        "step": 10,
        "default": 150,
        "unit": "px"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Idéalement une image carrée de 32 x 32 px"
      }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      {
        "type": "header",
        "content": "Titres"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Police des titres",
        "default": "garamond_n4",
        "info": "Une serif éditoriale pour les titres"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Échelle des titres",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "header",
        "content": "Texte courant"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Police du texte",
        "default": "jost_n4",
        "info": "Une sans-serif moderne pour les textes et boutons"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Échelle du texte",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Palette de couleurs",
    "settings": [
      {
        "type": "paragraph",
        "content": "Ces couleurs forment la palette globale de la maison. Chaque section peut ensuite choisir une ambiance (ivoire, sable, sauge, chocolat…) construite à partir de ces teintes."
      },
      {
        "type": "header",
        "content": "Fonds clairs"
      },
      {
        "type": "color",
        "id": "color_ivory",
        "label": "Ivoire",
        "default": "#F7F2E7"
      },
      {
        "type": "color",
        "id": "color_off_white",
        "label": "Blanc cassé",
        "default": "#FBFAF6"
      },
      {
        "type": "color",
        "id": "color_sand",
        "label": "Sable / beige chaud",
        "default": "#E7D9BC"
      },
      {
        "type": "header",
        "content": "Vert sauge"
      },
      {
        "type": "color",
        "id": "color_sage",
        "label": "Sauge claire",
        "default": "#B9C2A4"
      },
      {
        "type": "color",
        "id": "color_sage_dark",
        "label": "Sauge profonde",
        "default": "#5C6B4D"
      },
      {
        "type": "header",
        "content": "Tons chauds & accents"
      },
      {
        "type": "color",
        "id": "color_terracotta",
        "label": "Terracotta",
        "default": "#C1663F"
      },
      {
        "type": "color",
        "id": "color_bordeaux",
        "label": "Bordeaux discret",
        "default": "#6E2630"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Doré discret (accent)",
        "default": "#B38B4D"
      },
      {
        "type": "header",
        "content": "Fonds profonds"
      },
      {
        "type": "color",
        "id": "color_brown",
        "label": "Brun profond",
        "default": "#4B3A2F"
      },
      {
        "type": "color",
        "id": "color_chocolate",
        "label": "Fond sombre (header, pied de page, bandeaux)",
        "default": "#746764"
      },
      {
        "type": "color",
        "id": "color_stripes",
        "label": "Couleur des rayures",
        "default": "#CFC8C5"
      },
      {
        "type": "range",
        "id": "stripes_opacity",
        "label": "Intensité des rayures",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 30
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Noir doux (texte)",
        "default": "#2A2420"
      },
      {
        "type": "header",
        "content": "Texte sur fond clair / profond"
      },
      {
        "type": "color",
        "id": "color_text_on_light",
        "label": "Texte sur fond clair",
        "default": "#2A2420"
      },
      {
        "type": "color",
        "id": "color_text_on_dark",
        "label": "Texte sur fond profond",
        "default": "#F7F2E7"
      }
    ]
  },
  {
    "name": "Boutons & formes",
    "settings": [
      {
        "type": "range",
        "id": "border_radius",
        "label": "Arrondi des boutons et cartes",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "card_radius",
        "label": "Arrondi des images et cartes produit",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 0
      }
    ]
  },
  {
    "name": "Mise en page",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Largeur maximale du site",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "label": "Espacement vertical entre les sections",
        "min": 40,
        "max": 140,
        "step": 10,
        "unit": "px",
        "default": 100
      }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Type de panier",
        "options": [
          { "value": "drawer", "label": "Panier latéral (drawer)" },
          { "value": "page", "label": "Page panier classique" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_free_shipping_enable",
        "label": "Afficher une barre de livraison offerte",
        "default": true
      },
      {
        "type": "number",
        "id": "cart_free_shipping_threshold",
        "label": "Montant pour la livraison offerte (€)",
        "default": 60
      },
      {
        "type": "richtext",
        "id": "cart_note",
        "label": "Message complémentaire dans le panier",
        "default": "<p>Vos coffrets sont emballés avec soin, prêts à être offerts.</p>"
      }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "default": "https://www.instagram.com/lecrindugout/",
        "label": "Instagram",
        "info": "URL complète"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "default": "https://www.facebook.com/profile.php?id=61584056300790",
        "label": "Facebook",
        "info": "URL complète"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest",
        "info": "URL complète"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok",
        "info": "URL complète"
      }
    ]
  },
  {
    "name": "Réassurance (textes courts)",
    "settings": [
      {
        "type": "paragraph",
        "content": "Ces textes alimentent par défaut la barre d'annonce et le bandeau de réassurance."
      },
      {
        "type": "text",
        "id": "reassurance_shipping",
        "label": "Livraison",
        "default": "Livraison offerte dès 60 €"
      },
      {
        "type": "text",
        "id": "reassurance_delivery",
        "label": "Délai",
        "default": "Expédition rapide en 24/48h"
      },
      {
        "type": "text",
        "id": "reassurance_payment",
        "label": "Paiement",
        "default": "Paiement 100% sécurisé"
      },
      {
        "type": "text",
        "id": "reassurance_gift",
        "label": "Cadeaux",
        "default": "Coffrets cadeaux personnalisables"
      }
    ]
  }
]
