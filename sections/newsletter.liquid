<div class="section newsletter color-scheme-{{ section.settings.color_scheme }}{% if section.settings.stripes %} has-stripes{% endif %}">
  <div class="page-width">
    <div class="newsletter__inner" data-animate>
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.title != blank %}<h2>{{ section.settings.title | escape | replace: '|', '<br>' }}</h2>{% endif %}
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}

      {% form 'customer', id: 'NewsletterForm' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ 'newsletter.email' | t }}"
            aria-label="{{ 'newsletter.email' | t }}"
            required
            value="{% if customer %}{{ customer.email }}{% endif %}"
          >
          <button type="submit" class="btn btn--outline">{{ section.settings.button_label }}</button>
        </div>

        {% if form.posted_successfully? %}
          <p class="form-status form-status--success" style="margin-inline:auto; max-width:26rem;">{{ 'newsletter.success' | t }}</p>
        {% elsif form.errors %}
          <p class="form-status form-status--error" style="margin-inline:auto; max-width:26rem;">{{ 'newsletter.error' | t }}</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Ambiance de couleur",
      "options": [
        { "value": "chocolat", "label": "Taupe rayé" },
        { "value": "sauge-profond", "label": "Vert profond" },
        { "value": "brun", "label": "Brun" },
        { "value": "taupe-fonce", "label": "Taupe foncé" },
        { "value": "lin", "label": "Lin (taupe clair)" }
      ],
      "default": "sauge-profond"
    },
    { "type": "checkbox", "id": "stripes", "label": "Fines rayures sur le fond", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Mention courte", "default": "Newsletter" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Les nouvelles gourmandes", "info": "Tapez | pour forcer un retour à la ligne" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Recevez nos nouveautés, nos découvertes et nos inspirations directement dans votre boîte mail."
    },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "S'inscrire" }
  ]
}
{% endschema %}
