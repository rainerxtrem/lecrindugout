<section class="editorial-split editorial-split--reverse color-scheme-{{ section.settings.color_scheme }}{% if section.settings.color_scheme == 'chocolat' %} has-stripes{% endif %}">
  <div class="editorial-split__media">
    {% if section.settings.image %}
      <img
        src="{{ section.settings.image | image_url: width: 1400 }}"
        srcset="{{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 1100 }} 1100w, {{ section.settings.image | image_url: width: 1400 }} 1400w"
        sizes="(min-width: 900px) 50vw, 100vw"
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {% else %}
      <div class="media-fallback media-fallback--light"></div>
    {% endif %}
  </div>
  <div class="editorial-split__content{% if section.settings.color_scheme == 'chocolat' %} has-frame{% endif %}">
    <div class="editorial-split__inner" data-animate>
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.title != blank %}<h2>{{ section.settings.title | escape | replace: '|', '<br>' }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="editorial-split__text">{{ section.settings.text }}</div>{% endif %}

      {% if section.settings.note != blank %}
        <div class="corporate-note">
          {% render 'icon', name: 'truck' %}
          <span>{{ section.settings.note }}</span>
        </div>
      {% endif %}

      <div class="button-row">
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_url | default: '/pages/contact' }}" class="btn">{{ section.settings.button_label }}</a>
        {% endif %}
        {% if section.settings.button_label_2 != blank %}
          <a href="{{ section.settings.button_url_2 | default: '/pages/contact' }}" class="btn btn--outline">{{ section.settings.button_label_2 }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bandeau entreprises",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Ambiance de couleur",
      "options": [
        { "value": "chocolat", "label": "Taupe rayé" },
        { "value": "sauge-profond", "label": "Vert profond" },
        { "value": "sombre", "label": "Noir doux" },
        { "value": "ivoire", "label": "Ivoire" },
        { "value": "taupe-fonce", "label": "Taupe foncé" }
      ],
      "default": "chocolat"
    },
    { "type": "image_picker", "id": "image", "label": "Photographie" },
    { "type": "text", "id": "eyebrow", "label": "Mention courte", "default": "Entreprises" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Des cadeaux qui ont du goût", "info": "Tapez | pour forcer un retour à la ligne" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Pour remercier vos collaborateurs, partenaires ou clients, nous imaginons des coffrets gourmands adaptés à vos envies et à votre budget."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note (envoi postal)",
      "default": "Certains de nos coffrets sont également compatibles avec l'expédition par voie postale."
    },
    { "type": "text", "id": "button_label", "label": "Bouton principal", "default": "Créer mon cadeau d'entreprise" },
    { "type": "url", "id": "button_url", "label": "Lien du bouton principal" },
    { "type": "text", "id": "button_label_2", "label": "Bouton secondaire", "default": "Demander un devis" },
    { "type": "url", "id": "button_url_2", "label": "Lien du bouton secondaire" }
  ],
  "presets": [
    { "name": "Bandeau entreprises" }
  ]
}
{% endschema %}
