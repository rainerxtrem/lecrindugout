<div class="password color-scheme-chocolat has-stripes">
  <div class="password__inner">
    <p class="site-header__logo-text">{{ shop.name }}</p>
    <p class="site-header__tagline">{{ section.settings.tagline }}</p>
    {% if shop.password_message != blank %}
      <p class="password__message">{{ shop.password_message }}</p>
    {% endif %}

    {% form 'storefront_password', class: 'password__form' %}
      {{ form.errors | default_errors }}
      <label for="Password" class="visually-hidden">Mot de passe</label>
      <input type="password" name="password" id="Password" placeholder="Mot de passe" autocomplete="current-password">
      <button type="submit" class="btn">Entrer</button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Signature", "default": "Épicerie fine — Arnage" }
  ]
}
{% endschema %}
