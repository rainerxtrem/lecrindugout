{%- liquid
  assign main_menu = linklists[section.settings.menu]
-%}

<header class="site-header site-header--centered color-scheme-{{ section.settings.color_scheme }}{% if section.settings.stripes %} has-stripes{% endif %}" data-site-header>
  <div class="page-width site-header__top">
    <div class="site-header__left">
      <button class="btn--icon site-header__menu-btn" data-mobile-nav-open aria-label="{{ 'general.menu.open' | t }}">
        {% render 'icon', name: 'menu' %}
      </button>
      {% render 'social-icons', class: 'site-header__social' %}
    </div>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {% if settings.logo %}
        <img
          src="{{ settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name }}"
          width="{{ settings.logo.width }}"
          height="{{ settings.logo.height }}"
          style="--logo-width: {{ settings.logo_width }}px;"
        >
      {% else %}
        <span class="site-header__logo-text">{{ shop.name }}</span>
        {% if section.settings.tagline != blank %}
          <span class="site-header__tagline">{{ section.settings.tagline }}</span>
        {% endif %}
      {% endif %}
    </a>

    <div class="site-header__actions">
      {% if section.settings.show_search %}
        <button class="btn--icon" data-search-open aria-label="{{ 'general.search.search' | t }}">
          {% render 'icon', name: 'search' %}
        </button>
      {% endif %}

      <a href="{{ routes.account_url }}" class="btn--icon site-header__account" aria-label="{{ 'general.account.title' | t }}">
        {% render 'icon', name: 'account' %}
      </a>

      {% if settings.cart_type == 'drawer' %}
        <button class="btn--icon site-header__cart" data-cart-drawer-open aria-label="{{ 'cart.general.title' | t }}">
          {% render 'icon', name: 'cart' %}
          <span class="cart-count{% if cart.item_count == 0 %} hidden{% endif %}" data-cart-count>{{ cart.item_count }}</span>
        </button>
      {% else %}
        <a href="{{ routes.cart_url }}" class="btn--icon site-header__cart" aria-label="{{ 'cart.general.title' | t }}">
          {% render 'icon', name: 'cart' %}
          <span class="cart-count{% if cart.item_count == 0 %} hidden{% endif %}" data-cart-count>{{ cart.item_count }}</span>
        </a>
      {% endif %}
    </div>
  </div>

  {% if main_menu %}
    <nav class="site-nav" aria-label="{{ 'header.catalog' | t }}">
      <ul class="site-nav__list" role="list">
        {% for link in main_menu.links %}
          <li class="site-nav__item" data-nav-item>
            {% if link.links.size > 0 %}
              <button class="site-nav__link" data-nav-trigger aria-expanded="false" aria-haspopup="true">
                {{ link.title }}
                {% render 'icon', name: 'chevron-down' %}
              </button>
              {% render 'mega-menu', link: link, section: section %}
            {% else %}
              <a href="{{ link.url }}" class="site-nav__link{% if link.active %} is-active{% endif %}">{{ link.title }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}

  {% if section.settings.show_search %}
    <div class="header-search-panel" data-search-panel hidden>
      <form action="{{ routes.search_url }}" method="get" class="page-width header-search-panel__form">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
        <input type="hidden" name="type" value="product">
        <button type="submit" class="btn btn--small">{{ 'general.search.search' | t }}</button>
      </form>
    </div>
  {% endif %}
</header>

{% comment %} Navigation mobile {% endcomment %}
<div class="mobile-nav-drawer" data-mobile-nav hidden>
  <div class="mobile-nav-drawer__overlay" data-mobile-nav-close></div>
  <div class="mobile-nav-drawer__panel">
    <div class="mobile-nav-drawer__header">
      <button class="btn--icon" data-mobile-nav-close aria-label="{{ 'general.menu.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>
    {% if main_menu %}
      <nav class="mobile-nav" aria-label="{{ 'header.catalog' | t }}">
        {% for link in main_menu.links %}
          {% if link.links.size > 0 %}
            <details>
              <summary>{{ link.title }} {% render 'icon', name: 'chevron-down' %}</summary>
              <div class="mobile-nav__sublist">
                {% for child in link.links %}
                  {% if child.links.size > 0 %}
                    <p style="font-weight:600; margin: 8px 0 2px;">{{ child.title }}</p>
                    {% for grandchild in child.links %}
                      <a href="{{ grandchild.url }}" class="mobile-nav__link">{{ grandchild.title }}</a>
                    {% endfor %}
                  {% else %}
                    <a href="{{ child.url }}" class="mobile-nav__link">{{ child.title }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            </details>
          {% else %}
            <a href="{{ link.url }}" class="mobile-nav__link mobile-nav__link--top">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}

    <div style="margin-top:auto; padding-top:24px;">
      {% render 'social-icons' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "En-tête",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu principal",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Afficher la recherche",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Ambiance de couleur",
      "options": [
        { "value": "chocolat", "label": "Chocolat" },
        { "value": "sombre", "label": "Noir doux" },
        { "value": "sauge-profond", "label": "Vert profond" },
        { "value": "ivoire", "label": "Ivoire" },
        { "value": "blanc-casse", "label": "Blanc cassé" }
      ],
      "default": "chocolat"
    },
    {
      "type": "checkbox",
      "id": "stripes",
      "label": "Fines rayures sur le fond",
      "default": true
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Signature sous le nom",
      "info": "Affichée seulement sans logo image",
      "default": "Épicerie fine — Arnage"
    }
  ],
  "blocks": [
    {
      "type": "menu_feature",
      "name": "Image dans le mega-menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_item_title",
          "label": "Nom exact de l'item de menu ciblé",
          "info": "Doit correspondre exactement au libellé du lien de premier niveau (ex. Catalogue)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Légende"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Lien"
        }
      ]
    }
  ]
}
{% endschema %}
