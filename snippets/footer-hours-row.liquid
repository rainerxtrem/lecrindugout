{%- comment -%} Une ligne d'horaires du pied de page (un jour ou une plage de jours) {%- endcomment -%}
<div class="site-footer__hours-row">
  <dt>
    {%- assign day_list = days | split: ',' -%}
    {%- for d in day_list -%}{{ d | capitalize }}{% unless forloop.last %} – {% endunless %}{%- endfor -%}
  </dt>
  <dd>
    {%- assign slots = hours | split: '/' -%}
    {%- for slot in slots -%}<span>{{ slot | strip | replace: ' - ', '–' | replace: '-', '–' }}</span>{%- endfor -%}
  </dd>
</div>
