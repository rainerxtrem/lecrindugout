<div class="section color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="section-heading{% if section.settings.center_heading %} section-heading--center{% endif %}" data-animate>
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.title != blank %}<h2>{{ section.settings.title }}</h2>{% endif %}
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>

    <div class="grid grid--categories">
      {% for block in section.blocks %}
        {%- liquid
          assign cat_collection = collections[block.settings.collection]
          assign cat_image = block.settings.image
          if cat_image == blank and cat_collection != blank
            assign cat_image = cat_collection.featured_image
            if cat_image == blank
              for p in cat_collection.products limit: 24
                if p.featured_image
                  assign cat_image = p.featured_image
                  break
                endif
              endfor
            endif
          endif
          assign cat_title = block.settings.title | default: cat_collection.title
          assign cat_url = block.settings.url | default: cat_collection.url
        -%}
        <a href="{{ cat_url | default: routes.collections_url }}" class="category-card" data-animate {{ block.shopify_attributes }}>
          <div class="category-card__media">
            {% if cat_image %}
              <img
                src="{{ cat_image | image_url: width: 700 }}"
                srcset="{{ cat_image | image_url: width: 400 }} 400w, {{ cat_image | image_url: width: 700 }} 700w"
                sizes="(min-width: 990px) 400px, 50vw"
                alt="{{ cat_title | escape }}"
                loading="lazy"
                width="{{ cat_image.width }}"
                height="{{ cat_image.height }}"
              >
            {% else %}
              <div class="media-fallback media-fallback--light"></div>
            {% endif %}
          </div>
          <div class="category-card__content">
            <h3>{{ cat_title }}</h3>
            {% if block.settings.description != blank %}<p>{{ block.settings.description }}</p>{% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Catégories",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Ambiance de couleur",
      "options": [
        { "value": "ivoire", "label": "Ivoire" },
        { "value": "sauge-clair", "label": "Vert sauge clair" },
        { "value": "sable", "label": "Sable" },
        { "value": "lin", "label": "Lin (taupe clair)" }
      ],
      "default": "ivoire"
    },
    { "type": "checkbox", "id": "center_heading", "label": "Centrer le titre", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Mention courte", "default": "Collections" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Explorer l'épicerie" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Des grandes familles de produits, pensées pour la cuisine, la dégustation et le cadeau." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Facultatif : sinon l'image de la collection ou de son premier produit" },
        { "type": "text", "id": "title", "label": "Nom", "info": "Facultatif : sinon le nom de la collection" },
        { "type": "textarea", "id": "description", "label": "Description courte" },
        { "type": "url", "id": "url", "label": "Lien", "info": "Facultatif : sinon la page de la collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Catégories",
      "blocks": [
        { "type": "category", "settings": { "title": "Sucré" } },
        { "type": "category", "settings": { "title": "Salé" } },
        { "type": "category", "settings": { "title": "Chocolats" } },
        { "type": "category", "settings": { "title": "Condiments" } },
        { "type": "category", "settings": { "title": "Boissons" } },
        { "type": "category", "settings": { "title": "Coffrets cadeaux" } }
      ]
    }
  ]
}
{% endschema %}
